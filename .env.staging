# ── TrustLedger STAGING environment ──────────────────────────────────────────
# Copy this to .env on the Railway staging service.
# Never commit real secrets — use Railway's variable injection.

NODE_ENV=staging
PORT=3000

# Staging PostgreSQL — create a separate Railway service for this
DATABASE_URL=postgresql://USER:PASS@HOST:PORT/railway_staging

# Staging JWT — different secret from production
JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET

# Stripe TEST keys (never use live keys in staging)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# WebAuthn — point to staging wallet URL
WEBAUTHN_RPID=synthpay-wallet-staging.vercel.app
WEBAUTHN_ORIGIN=https://synthpay-wallet-staging.vercel.app
APP_URL=https://synthpay-wallet-staging.vercel.app

# Resend — use the same key but a staging from-address
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=SynthPay Staging <staging@synthpay.io>

# Platform fee — keep identical to production
PLATFORM_FEE=0.015

# Audit
AUDIT_SECRET=CHANGE_ME_STAGING_AUDIT_SECRET
